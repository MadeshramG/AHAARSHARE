<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="description" content="Post a food donation on AaharShare.">
  <title>AaharShare - <%= donation ? 'Edit' : 'New' %> Donation</title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('partials/pwa-head') %>
</head>
<body>
  <div class="app-shell">
    <!-- Top Navbar -->
    <nav class="navbar">
      <a href="/dashboard" class="nav-brand">
        <div class="brand-icon">🍛</div>
        <h1>AaharShare</h1>
      </a>
      <div class="nav-actions">
        <a href="/donations" class="logout-btn" style="border-color: var(--border); color: var(--text-secondary);">← Back</a>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content form-page">
      <h2><%= donation ? '✏️ Edit Donation' : '➕ Donate Food' %></h2>

      <% if (error) { %>
        <div class="alert alert-danger">⚠️ <%= error %></div>
      <% } %>

      <div class="form-card">
        <form action="<%= donation ? '/donations/' + donation._id : '/donations' %>" method="POST">
          <div class="form-group">
            <label for="foodName">Food Name</label>
            <input type="text" id="foodName" name="foodName" class="form-control" 
                   placeholder="e.g., Rice & Dal, Biryani, Rotis"
                   value="<%= donation ? donation.foodName : '' %>" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="foodType">Food Type</label>
              <select id="foodType" name="foodType" class="form-control" required>
                <option value="veg" <%= donation && donation.foodType === 'veg' ? 'selected' : '' %>>🟢 Vegetarian</option>
                <option value="non-veg" <%= donation && donation.foodType === 'non-veg' ? 'selected' : '' %>>🔴 Non-Veg</option>
              </select>
            </div>
            <div class="form-group">
              <label for="servings">Servings (approx)</label>
              <input type="number" id="servings" name="servings" class="form-control" 
                     placeholder="e.g., 50"
                     value="<%= donation ? donation.servings : '' %>" min="1" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="quantity">Quantity</label>
              <input type="text" id="quantity" name="quantity" class="form-control" 
                     placeholder="e.g., 5 kg, 20 plates"
                     value="<%= donation ? donation.quantity : '' %>" required>
            </div>
            <div class="form-group">
              <label for="cookedAt">Cooked At (Time)</label>
              <input type="text" id="cookedAt" name="cookedAt" class="form-control" 
                     placeholder="e.g., 12:30 PM today"
                     value="<%= donation ? donation.cookedAt : '' %>" required>
            </div>
          </div>

          <div class="form-group">
            <label for="pickupAddress">Pickup Address</label>
            <input type="text" id="pickupAddress" name="pickupAddress" class="form-control" 
                   placeholder="Full address for pickup"
                   value="<%= donation ? donation.pickupAddress : '' %>" required>
          </div>

          <div class="form-group">
            <label for="contactPhone">Contact Phone</label>
            <input type="tel" id="contactPhone" name="contactPhone" class="form-control" 
                   placeholder="Contact number for pickup"
                   value="<%= donation ? donation.contactPhone : '' %>" required>
          </div>

          <div class="form-group">
            <label for="description">Description (Optional)</label>
            <textarea id="description" name="description" class="form-control" 
                      placeholder="Any special instructions or details..."><%= donation ? donation.description : '' %></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block mt-1">
            <%= donation ? '💾 Update Donation' : '🍽️ Post Donation' %>
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
      <a href="/dashboard">
        <span class="nav-icon">🏠</span>
        Home
      </a>
      <a href="/donations">
        <span class="nav-icon">📋</span>
        Feed
      </a>
      <a href="/donations/new" class="active">
        <span class="nav-icon">➕</span>
        Donate
      </a>
    </nav>
  </div>
  <%- include('partials/pwa-script') %>
</body>
</html>
